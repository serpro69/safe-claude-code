{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",

    "deny": [
      "Bash(dangerouslyDisableSandbox:true)",

      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "Bash(srm *)",
      "Bash(trash *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(doas *)",
      "Bash(dd *)",
      "Bash(diskutil *)",
      "Bash(mkfs *)",
      "Bash(newfs *)",
      "Bash(fdisk *)",
      "Bash(hdiutil *)",
      "Bash(tmutil *)",
      "Bash(chown *)",
      "Bash(chgrp *)",
      "Bash(chflags *)",
      "Bash(chmod -R *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(halt *)",
      "Bash(launchctl *)",
      "Bash(systemsetup *)",
      "Bash(csrutil *)",
      "Bash(spctl *)",
      "Bash(nvram *)",
      "Bash(pmset *)",
      "Bash(scutil *)",
      "Bash(softwareupdate *)",
      "Bash(crontab *)",
      "Bash(at *)",
      "Bash(defaults write *)",
      "Bash(defaults delete *)",
      "Bash(security *)",
      "Bash(dscl *)",
      "Bash(osascript *)",
      "Bash(automator *)",
      "Bash(claude *)",
      "Bash(eval *)",
      "Bash(truncate *)",

      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout . *)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git reflog expire *)",
      "Bash(git gc *)",
      "Bash(git prune *)",
      "Bash(git rm *)",
      "Bash(git commit --amend *)",

      "Bash(find * -delete *)",
      "Bash(find * -exec *)",
      "Bash(xargs rm *)",
      "Bash(xargs sudo *)",
      "Bash(brew install *)",
      "Bash(brew uninstall *)",
      "Bash(brew remove *)",
      "Bash(brew upgrade *)",
      "Bash(brew cleanup *)",
      "Bash(brew services *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(pip uninstall *)",
      "Bash(pip3 uninstall *)",
      "Bash(conda remove *)",
      "Bash(conda env remove *)",
      "Bash(rsync * --delete *)",
      "Bash(sed -i *)",

      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)",
      "Read(~/.pypirc)",
      "Read(~/.docker/config.json)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Application Support/Google/Chrome/**)",
      "Read(~/Library/Application Support/Firefox/**)",
      "Read(~/Library/Safari/**)",
      "Read(~/Library/Messages/**)",
      "Read(~/Library/Mail/**)",
      "Read(~/.claude/.credentials.json)",

      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/.claude/workflows/**)",
      "Edit(~/.claude.json)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.mcp.json)",
      "Edit(//Library/**)",
      "Edit(//usr/local/claude-guard/**)",
      "Edit(//System/**)",
      "Edit(//usr/**)",
      "Edit(//bin/**)",
      "Edit(//sbin/**)",
      "Edit(//etc/**)",
      "Edit(//private/etc/**)",
      "Edit(//Applications/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/Library/Keychains/**)",
      "Edit(~/Library/Preferences/**)",
      "Edit(~/Library/Application Support/**)",
      "Edit(~/Library/Cookies/**)",
      "Edit(~/Library/Safari/**)",
      "Edit(~/Library/Mail/**)",
      "Edit(~/Library/Messages/**)",
      "Edit(~/Library/Accounts/**)",
      "Edit(~/Library/Group Containers/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshenv)",
      "Edit(~/.zlogin)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.profile)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)",
      "Edit(.git/**)",
      "Edit(.latexmkrc)",
      "Edit(latexmkrc)",
      "Edit(.Rprofile)",
      "Edit(.Renviron)"
    ],

    "ask": [
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(uv add *)",
      "Bash(uv pip install *)",
      "Bash(conda install *)",
      "Bash(conda create *)",
      "Bash(npm install *)",
      "Bash(mv *)"
    ]
  },

  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [],
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": false,
    "allowAppleEvents": false,
    "network": {
      "allowLocalBinding": true,
      "allowAllUnixSockets": false,
      "allowUnixSockets": [],
      "allowedDomains": [
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "*.pythonhosted.org",
        "cran.r-project.org",
        "cloud.r-project.org",
        "*.r-project.org",
        "bioconductor.org",
        "*.bioconductor.org",
        "conda.anaconda.org",
        "repo.anaconda.com",
        "*.anaconda.org",
        "*.anaconda.com",
        "conda-forge.org",
        "registry.npmjs.org",
        "*.npmjs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "gitlab.com",
        "huggingface.co",
        "*.huggingface.co",
        "*.hf.co",
        "ctan.org",
        "*.ctan.org",
        "tug.org",
        "*.tug.org",
        "arxiv.org",
        "*.arxiv.org",
        "doi.org",
        "*.doi.org",
        "api.crossref.org",
        "*.crossref.org",
        "pubmed.ncbi.nlm.nih.gov",
        "*.nih.gov",
        "europepmc.org",
        "*.europepmc.org",
        "api.semanticscholar.org",
        "*.semanticscholar.org",
        "zenodo.org",
        "*.zenodo.org",
        "osf.io",
        "*.osf.io",
        "dataverse.harvard.edu",
        "scholar.google.com",
        "docs.python.org",
        "*.readthedocs.io",
        "numpy.org",
        "pandas.pydata.org",
        "scikit-learn.org",
        "matplotlib.org",
        "scipy.org",
        "pytorch.org",
        "download.pytorch.org",
        "stackoverflow.com",
        "*.stackexchange.com",
        "en.wikipedia.org",
        "*.wikipedia.org"
      ]
    },
    "filesystem": {
      "denyWrite": [
        "~/Library/LaunchAgents",
        "~/Library/Keychains",
        "~/Library/Preferences",
        "~/Library/Application Support",
        "~/Library/Cookies",
        "~/Library/Safari",
        "~/Library/Mail",
        "~/Library/Messages",
        "~/Library/Accounts",
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config",
        "~/.claude",
        "~/.claude.json",
        "~/.zshrc",
        "~/.zprofile",
        "~/.zshenv",
        "~/.bashrc",
        "~/.bash_profile",
        "~/.profile",
        "~/.gitconfig",
        "/usr/local/claude-guard"
      ],
      "denyRead": []
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.gnupg", "mode": "deny" },
        { "path": "~/.kube", "mode": "deny" },
        { "path": "~/.config/gcloud", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.pypirc", "mode": "deny" },
        { "path": "~/.docker/config.json", "mode": "deny" },
        { "path": "~/Library/Keychains", "mode": "deny" },
        { "path": "~/.claude/.credentials.json", "mode": "deny" }
      ],
      "envVars": [
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "HF_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "PYPI_TOKEN", "mode": "deny" }
      ]
    }
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/claude-guard/guard.sh",
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "Safety check"
          }
        ]
      }
    ]
  },

  "disableAllHooks": false,
  "allowManagedHooksOnly": true,
  "disableSkillShellExecution": true,
  "disableSideloadFlags": true,
  "disableCommandPluginSources": true,
  "strictKnownMarketplaces": [],
  "enableAllProjectMcpServers": false,
  "fileCheckpointingEnabled": true,
  "cleanupPeriodDays": 90
}
